rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Firebase Storage security rules in this project cannot reliably read
    // Firestore in production (cross-service firestore.get()/exists() calls
    // from storage.rules deny even for docs the caller legitimately owns,
    // confirmed by isolated rule testing - see the
    // storage-rules-cross-service-broken memory). Every business-scoped
    // upload rule used to depend on exactly that kind of read, which is why
    // business logo/profile/listing/verification uploads silently failed
    // for non-admin users despite the client reporting a normal "saved"
    // flow. functions/index.js's syncUserCustomClaims trigger mirrors each
    // user's role/businessId/adminRole/businessPermissions from their
    // Firestore profile onto their Auth token any time that profile
    // changes, so these rules can read request.auth.token.* directly -
    // no cross-service call needed for any of the checks below.
    function userRole() {
      return request.auth != null ? request.auth.token.get('role', '') : '';
    }

    function userBusinessId() {
      return request.auth != null ?
        request.auth.token.get('businessId', '') : '';
    }

    function userAdminRole() {
      return request.auth != null ?
        request.auth.token.get('adminRole', '') : '';
    }

    function userBusinessPermissions() {
      return request.auth != null ?
        request.auth.token.get('businessPermissions', []) : [];
    }

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        userRole() == 'admin';
    }

    function isLinkedToBusiness(businessId) {
      return request.auth != null && userBusinessId() == businessId;
    }

    function isSuperAdmin() {
      return request.auth != null &&
        userRole() == 'admin' &&
        userAdminRole() == 'superAdmin';
    }

    // Custom per-role permission overrides (platformConfig/permissions) are
    // still Firestore-backed, so this one check remains subject to the same
    // cross-service limitation as before - a narrower, pre-existing gap
    // than the business-scoped checks this file otherwise fixes.
    function hasDynamicAdminCapability(section) {
      return firestore.exists(/databases/(default)/documents/platformConfig/permissions) &&
        userAdminRole() in firestore.get(/databases/(default)/documents/platformConfig/permissions).data.roles &&
        firestore.get(/databases/(default)/documents/platformConfig/permissions).data.roles[userAdminRole()].sections is map &&
        section in firestore.get(/databases/(default)/documents/platformConfig/permissions).data.roles[userAdminRole()].sections &&
        firestore.get(/databases/(default)/documents/platformConfig/permissions).data.roles[userAdminRole()].sections[section] == 'manage';
    }

    function hasBuiltInAdminCapability(section) {
      return isSuperAdmin() ||
        (
          userAdminRole() == 'operationsManager' &&
          section in ['businesses', 'marketplace', 'operations', 'support', 'website']
        ) ||
        (
          userAdminRole() == 'financeManager' &&
          section in ['finance', 'support']
        ) ||
        (userAdminRole() == 'supportAdmin' && section == 'support') ||
        (userAdminRole() == 'contentManager' && section == 'website');
    }

    function hasAdminCapability(section) {
      return isAdmin() &&
        (hasBuiltInAdminCapability(section) ||
         hasDynamicAdminCapability(section));
    }

    function hasBusinessSection(section) {
      return section in userBusinessPermissions();
    }

    function canManageBusinessLogo(businessId) {
      return hasAdminCapability('businesses') ||
        (
          isLinkedToBusiness(businessId) &&
          userRole() == 'businessOwner'
        );
    }

    function canManageBusinessListingImages(businessId) {
      return hasAdminCapability('marketplace') ||
        (
          isLinkedToBusiness(businessId) &&
          (
            userRole() == 'businessOwner' ||
            (
              userRole() == 'staff' &&
              hasBusinessSection('listings')
            )
          )
        );
    }

    function canManageBusinessProfileImages(businessId) {
      return hasAdminCapability('businesses') ||
        (
          isLinkedToBusiness(businessId) &&
          (
            userRole() == 'businessOwner' ||
            (
              userRole() == 'staff' &&
              hasBusinessSection('profile')
            )
          )
        );
    }

    function canManageBusinessVerificationDocuments(businessId) {
      return hasAdminCapability('businesses') ||
        (
          isLinkedToBusiness(businessId) &&
          (
            userRole() == 'businessOwner' ||
            (
              userRole() == 'staff' &&
              hasBusinessSection('profile')
            )
          )
        );
    }

    function canManageBusinessSupportAsMember(businessId) {
      return isLinkedToBusiness(businessId) &&
        (
          userRole() == 'businessOwner' ||
          (
            userRole() == 'staff' &&
            hasBusinessSection('support')
          )
        );
    }

    function validImageUpload() {
      return request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    function validBusinessDocumentUpload() {
      return request.resource.size < 20 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType == 'application/msword' ||
          request.resource.contentType == 'application/octet-stream' ||
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        );
    }

    function validBusinessVerificationDocumentId(documentId) {
      return documentId in [
        'shippingAuthority',
        'dealerLicense',
        'parkingFacilityProof',
        'transportInsurance'
      ];
    }

    // Support-case membership (customer/participant/business) is inherently
    // per-case data that only Firestore has, so this check is still
    // Firestore-backed and still subject to the cross-service limitation
    // above for non-admins. The support_cases write rule below does not
    // depend on it for that reason - see the comment there.
    function canAccessSupportCase(caseId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/supportCases/$(caseId)) &&
        (
          firestore.get(/databases/(default)/documents/supportCases/$(caseId)).data.customerUid == request.auth.uid ||
          firestore.exists(/databases/(default)/documents/supportCases/$(caseId)/participants/$(request.auth.uid)) ||
          hasAdminCapability('support') ||
          (
            'businessId' in firestore.get(/databases/(default)/documents/supportCases/$(caseId)).data &&
            canManageBusinessSupportAsMember(firestore.get(/databases/(default)/documents/supportCases/$(caseId)).data.businessId)
          )
        );
    }

    // Access control is enforced by the scoped path (support_cases/{caseId}/
    // {uploaderUid}) + a size cap. It deliberately does NOT call
    // canAccessSupportCase here (that needs a cross-service Firestore read
    // that fails in prod for non-admins) - the uploadSupportAttachmentMetadata
    // callable validates the real content type and case membership, using
    // the Admin SDK, before the file ever becomes a message.
    function validSupportUpload() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    match /cars/{businessId}/{carId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        validImageUpload() &&
        canManageBusinessListingImages(businessId);
    }

    match /cars/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /businesses/{businessId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        validImageUpload() &&
        canManageBusinessProfileImages(businessId);
    }

    match /businessLogos/{businessId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        validImageUpload() &&
        canManageBusinessLogo(businessId);
    }

    match /businessDocuments/{businessId}/{documentId}/{fileName} {
      allow read: if request.auth != null &&
        (hasAdminCapability('businesses') || isLinkedToBusiness(businessId));
      allow write: if request.auth != null &&
        validBusinessVerificationDocumentId(documentId) &&
        validBusinessDocumentUpload() &&
        canManageBusinessVerificationDocuments(businessId);
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // A user may only write under their own uid subfolder, and only if they can
    // access the support case. The callable still validates the real file type
    // before making the attachment visible as a message.
    match /support_cases/{caseId}/{uploaderUid}/{allPaths=**} {
      allow read: if request.auth != null &&
        (request.auth.uid == uploaderUid || canAccessSupportCase(caseId));
      allow write: if request.auth != null &&
        request.auth.uid == uploaderUid &&
        validSupportUpload();
    }

    // Optional: allow read-only access for other files if needed
    match /{allPaths=**} {
      allow read: if false;
    }
  }
}
