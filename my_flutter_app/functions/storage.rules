rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Firebase Storage security rules in this project cannot reliably read
    // Firestore in production (cross-service firestore.get()/exists() calls
    // from storage.rules deny even for docs the caller legitimately owns,
    // confirmed by isolated rule testing - see the
    // storage-rules-cross-service-broken memory). Every business-scoped
    // upload rule used to depend on exactly that kind of read, which is why
    // business logo/profile/listing/verification uploads silently failed
    // for non-admin users despite the client reporting a normal "saved"
    // flow. functions/index.js's syncUserCustomClaims trigger mirrors each
    // user's role/businessId/adminRole/businessPermissions from their
    // Firestore profile onto their Auth token any time that profile
    // changes, so these rules can read request.auth.token.* directly -
    // no cross-service call needed for any of the checks below.
    function userRole() {
      return request.auth != null ? request.auth.token.get('role', '') : '';
    }

    function userBusinessId() {
      return request.auth != null ?
        request.auth.token.get('businessId', '') : '';
    }

    function userAdminRole() {
      return request.auth != null ?
        request.auth.token.get('adminRole', '') : '';
    }

    function userBusinessPermissions() {
      return request.auth != null ?
        request.auth.token.get('businessPermissions', []) : [];
    }

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        userRole() == 'admin';
    }

    function isLinkedToBusiness(businessId) {
      return request.auth != null && userBusinessId() == businessId;
    }

    function isSuperAdmin() {
      return request.auth != null &&
        userRole() == 'admin' &&
        userAdminRole() == 'superAdmin';
    }

    // Custom per-role permission overrides (platformConfig/permissions) are
    // still Firestore-backed, so this one check remains subject to the same
    // cross-service limitation as before - a narrower, pre-existing gap
    // than the business-scoped checks this file otherwise fixes.
    function hasDynamicAdminCapability(section) {
      return firestore.exists(/databases/(default)/documents/platformConfig/permissions) &&
        userAdminRole() in firestore.get(/databases/(default)/documents/platformConfig/permissions).data.roles &&
        firestore.get(/databases/(default)/documents/platformConfig/permissions).data.roles[userAdminRole()].sections is map &&
        section in firestore.get(/databases/(default)/documents/platformConfig/permissions).data.roles[userAdminRole()].sections &&
        firestore.get(/databases/(default)/documents/platformConfig/permissions).data.roles[userAdminRole()].sections[section] == 'manage';
    }

    function hasBuiltInAdminCapability(section) {
      return isSuperAdmin() ||
        (
          userAdminRole() == 'operationsManager' &&
          section in ['businesses', 'marketplace', 'operations', 'support', 'website']
        ) ||
        (
          userAdminRole() == 'financeManager' &&
          section in ['finance', 'support']
        ) ||
        (userAdminRole() == 'supportAdmin' && section == 'support') ||
        (userAdminRole() == 'contentManager' && section == 'website');
    }

    function hasAdminCapability(section) {
      return isAdmin() &&
        (hasBuiltInAdminCapability(section) ||
         hasDynamicAdminCapability(section));
    }

    function hasBusinessSection(section) {
      return section in userBusinessPermissions();
    }

    function canManageBusinessLogo(businessId) {
      return hasAdminCapability('businesses') ||
        (
          isLinkedToBusiness(businessId) &&
          userRole() == 'businessOwner'
        );
    }

    function canManageBusinessListingImages(businessId) {
      return hasAdminCapability('marketplace') ||
        (
          isLinkedToBusiness(businessId) &&
          (
            userRole() == 'businessOwner' ||
            (
              userRole() == 'staff' &&
              hasBusinessSection('listings')
            )
          )
        );
    }

    function canManageBusinessProfileImages(businessId) {
      return hasAdminCapability('businesses') ||
        (
          isLinkedToBusiness(businessId) &&
          (
            userRole() == 'businessOwner' ||
            (
              userRole() == 'staff' &&
              hasBusinessSection('profile')
            )
          )
        );
    }

    function canManageBusinessVerificationDocuments(businessId) {
      return hasAdminCapability('businesses') ||
        (
          isLinkedToBusiness(businessId) &&
          (
            userRole() == 'businessOwner' ||
            (
              userRole() == 'staff' &&
              hasBusinessSection('profile')
            )
          )
        );
    }

    function canManageBusinessSupportAsMember(businessId) {
      return isLinkedToBusiness(businessId) &&
        (
          userRole() == 'businessOwner' ||
          (
            userRole() == 'staff' &&
            hasBusinessSection('support')
          )
        );
    }

    function validImageUpload() {
      return request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    function validBusinessDocumentUpload() {
      return request.resource.size < 20 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType == 'application/msword' ||
          request.resource.contentType == 'application/octet-stream' ||
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        );
    }

    function validBusinessVerificationDocumentId(documentId) {
      return documentId in [
        'shippingAuthority',
        'dealerLicense',
        'parkingFacilityProof',
        'transportInsurance'
      ];
    }

    // Support-case membership (customer/participant/business) is inherently
    // per-case data that only Firestore has, so this check is still
    // Firestore-backed and still subject to the cross-service limitation
    // above for non-admins. The support_cases write rule below does not
    // depend on it for that reason - see the comment there.
    function canAccessSupportCase(caseId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/supportCases/$(caseId)) &&
        (
          firestore.get(/databases/(default)/documents/supportCases/$(caseId)).data.customerUid == request.auth.uid ||
          firestore.exists(/databases/(default)/documents/supportCases/$(caseId)/participants/$(request.auth.uid)) ||
          hasAdminCapability('support') ||
          (
            'businessId' in firestore.get(/databases/(default)/documents/supportCases/$(caseId)).data &&
            canManageBusinessSupportAsMember(firestore.get(/databases/(default)/documents/supportCases/$(caseId)).data.businessId)
          ) ||
          // WhatsApp conversations: everyone at the business.
          (
            firestore.get(/databases/(default)/documents/supportCases/$(caseId)).data.get('caseType', '') == 'whatsapp' &&
            firestore.get(/databases/(default)/documents/supportCases/$(caseId)).data.get('businessId', '') != '' &&
            isLinkedToBusiness(firestore.get(/databases/(default)/documents/supportCases/$(caseId)).data.businessId)
          )
        );
    }

    // Access control is enforced by the scoped path (support_cases/{caseId}/
    // {uploaderUid}) + a type/size allow-list. It deliberately does NOT call
    // canAccessSupportCase here (that needs a cross-service Firestore read
    // that fails in prod for non-admins) - the uploadSupportAttachmentMetadata
    // callable re-validates the type and case membership, using the Admin
    // SDK, before the file ever becomes a message. The allow-list mirrors that
    // callable exactly (both clients upload with the same contentType they
    // send it), so anything refused here would have been refused there too:
    // the old size-only cap let any signed-in user park 50MB of arbitrary
    // bytes (HTML, executables, application/octet-stream) per request.
    function validSupportUpload() {
      return request.resource.contentType is string &&
        (
          (request.resource.contentType.matches('image/.*') &&
            request.resource.size < 10 * 1024 * 1024) ||
          (request.resource.contentType.matches('audio/.*') &&
            request.resource.size < 10 * 1024 * 1024) ||
          (request.resource.contentType.matches('video/.*') &&
            request.resource.size < 50 * 1024 * 1024) ||
          (request.resource.contentType in [
              'application/pdf',
              'text/plain',
              'application/msword',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
            ] &&
            request.resource.size < 25 * 1024 * 1024)
        );
    }

    // A lot-ledger receipt is a photo or a PDF (console accepts
    // "image/*,application/pdf"; the app uploads camera/gallery JPEGs).
    function validReceiptUpload() {
      return request.resource.size < 20 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf'
        );
    }

    match /cars/{businessId}/{carId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        validImageUpload() &&
        canManageBusinessListingImages(businessId);
    }

    match /cars/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Lot-ledger expense receipts. Written by a business's own ledger managers
    // (or an operations admin); readable by the same. Image or PDF only, under
    // 20MB (validReceiptUpload).
    function canManageBusinessLedger(businessId) {
      return hasAdminCapability('operations') ||
        (
          isLinkedToBusiness(businessId) &&
          (
            userRole() == 'businessOwner' ||
            (userRole() == 'staff' && hasBusinessSection('ledger'))
          )
        );
    }

    match /lotExpenseProofs/{businessId}/{allPaths=**} {
      allow read: if request.auth != null &&
        (hasAdminCapability('operations') || isLinkedToBusiness(businessId));
      allow write: if request.auth != null &&
        validReceiptUpload() &&
        canManageBusinessLedger(businessId);
    }

    match /businesses/{businessId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        validImageUpload() &&
        canManageBusinessProfileImages(businessId);
    }

    match /businessLogos/{businessId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        validImageUpload() &&
        canManageBusinessLogo(businessId);
    }

    match /businessDocuments/{businessId}/{documentId}/{fileName} {
      allow read: if request.auth != null &&
        (hasAdminCapability('businesses') || isLinkedToBusiness(businessId));
      allow write: if request.auth != null &&
        validBusinessVerificationDocumentId(documentId) &&
        validBusinessDocumentUpload() &&
        canManageBusinessVerificationDocuments(businessId);
    }

    // Account profile photos (app: users/{uid}/profile/..., console:
    // users/{uid}/admin_profile_...). Every screen that shows one renders the
    // tokenized download URL saved on the profile, which does not go through
    // these rules, so a path read is only needed by the uploader itself (to
    // mint that URL) and by admins. Writes are the owner's own images only:
    // previously any signed-in user could read every user's folder and the
    // owner could store any type at any size.
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        validImageUpload();
    }

    // A user may only write under their own uid subfolder, and only if they can
    // access the support case. The callable still validates the real file type
    // before making the attachment visible as a message.
    match /support_cases/{caseId}/{uploaderUid}/{allPaths=**} {
      allow read: if request.auth != null &&
        (request.auth.uid == uploaderUid || canAccessSupportCase(caseId));
      allow write: if request.auth != null &&
        request.auth.uid == uploaderUid &&
        validSupportUpload();
    }

    // Package request photos (docs/PACKAGE_REQUESTS.md §8.4). The customer's
    // own session - anonymous on the website - uploads compressed images to
    // its own folder before submitting; submitPackageRequest checks each
    // path belongs to the caller and re-checks type and size. Create only:
    // nobody overwrites or deletes through the client (the server deletes
    // them 90 days after the request ends). Read by the uploader and the
    // business's owner and staff who work containers (token claims).
    function validRequestPhotoUpload() {
      return request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // The owner, container staff, and - since docs/AIR_PACKAGES.md - the
    // deliveries-only agent, who must see the drop-off photos at handover.
    function canReadBusinessContainers(businessId) {
      return isLinkedToBusiness(businessId) &&
        (
          userRole() == 'businessOwner' ||
          (
            userRole() == 'staff' &&
            (
              hasBusinessSection('containers') ||
              hasBusinessSection('deliveries')
            )
          )
        );
    }

    match /packageRequestPhotos/{businessId}/{uploaderUid}/{fileName} {
      allow read: if request.auth != null &&
        (
          request.auth.uid == uploaderUid ||
          canReadBusinessContainers(businessId) ||
          (isAdmin() && hasBuiltInAdminCapability('operations'))
        );
      allow create: if request.auth != null &&
        resource == null &&
        request.auth.uid == uploaderUid &&
        fileName.matches('^[A-Za-z0-9_-]{8,64}([.](jpg|jpeg|png|webp))?$') &&
        validRequestPhotoUpload();
      allow update, delete: if false;
    }

    // Package photos (docs/AIR_PACKAGES.md §2 "Storage"): the drop-off
    // photos staff take, the handover photo, and the copies the server makes
    // of a customer's request or WhatsApp photos (folders `req` and `wa`,
    // server-only). Upload: the owner or staff with containers or deliveries,
    // into their OWN uid folder only (the line does not exist yet when the
    // photo is taken); the callables re-check the path, type and size from
    // the stored metadata (package_proof.js). Create only, image under 2 MB,
    // a file id of 8-64 safe characters. Read: the same people and platform
    // operations admins. The server deletes the files 12 months after
    // delivery; nobody deletes through the client.
    function validPackagePhotoUpload() {
      return request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    match /packagePhotos/{businessId}/{uploaderUid}/{fileName} {
      allow read: if request.auth != null &&
        (
          canReadBusinessContainers(businessId) ||
          (isAdmin() && hasBuiltInAdminCapability('operations'))
        );
      allow create: if request.auth != null &&
        resource == null &&
        request.auth.uid == uploaderUid &&
        canReadBusinessContainers(businessId) &&
        fileName.matches('^[A-Za-z0-9_-]{8,64}[.](jpg|jpeg|png|webp)$') &&
        validPackagePhotoUpload();
      allow update, delete: if false;
    }

    // Optional: allow read-only access for other files if needed
    match /{allPaths=**} {
      allow read: if false;
    }
  }
}
