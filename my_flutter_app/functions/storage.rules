rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /cars/{carId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /businesses/{businessId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (
            firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.businessId == businessId &&
            firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['businessOwner', 'staff']
          )
        );
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Optional: allow read-only access for other files if needed
    match /{allPaths=**} {
      allow read: if false;
    }
  }
}
