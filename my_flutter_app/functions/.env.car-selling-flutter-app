# Functions environment for the production project car-selling-flutter-app.
# `firebase deploy` loads it on top of .env for this project id only; the
# emulator suites run as demo-* projects and never read it. Committed on
# purpose: no secrets here (PLAID_CLIENT_ID, PLAID_SECRET and BANK_TOKEN_KEY
# live in Secret Manager). See docs/ZELLE_BANK_CHECK.md.

# Plaid: real banks. PLAID_SECRET in this project must be the production one.
# Emulators and tests are forced to sandbox in plaid_client.plaidEnvironment.
PLAID_ENV=production
# No Link customization: production refused "laawol" (INVALID_LINK_CUSTOMIZATION)
# and one must match the language; Plaid's default still names "Laawol".
