{
  "periodCases": [
    {"name": "monthly: three months from the 1st",
     "assignment": {"startDayKey": "2026-11-01", "endDayKey": null, "period": "monthly", "dueDay": 1},
     "through": "2027-01-15",
     "expect": [
       {"periodFrom": "2026-11-01", "periodTo": "2026-11-30", "dueDayKey": "2026-11-01"},
       {"periodFrom": "2026-12-01", "periodTo": "2026-12-31", "dueDayKey": "2026-12-01"},
       {"periodFrom": "2027-01-01", "periodTo": "2027-01-31", "dueDayKey": "2027-01-01"}]},
    {"name": "monthly: starting on the 31st clamps in February",
     "assignment": {"startDayKey": "2026-01-31", "endDayKey": null, "period": "monthly", "dueDay": 5},
     "through": "2026-03-31",
     "expect": [
       {"periodFrom": "2026-01-31", "periodTo": "2026-02-27", "dueDayKey": "2026-01-05"},
       {"periodFrom": "2026-02-28", "periodTo": "2026-03-30", "dueDayKey": "2026-02-05"},
       {"periodFrom": "2026-03-31", "periodTo": "2026-04-29", "dueDayKey": "2026-03-05"}]},
    {"name": "monthly: leap February has 29 days",
     "assignment": {"startDayKey": "2028-02-01", "endDayKey": null, "period": "monthly", "dueDay": 28},
     "through": "2028-02-20",
     "expect": [
       {"periodFrom": "2028-02-01", "periodTo": "2028-02-29", "dueDayKey": "2028-02-28"}]},
    {"name": "monthly: stops at the period holding the end day",
     "assignment": {"startDayKey": "2026-11-01", "endDayKey": "2026-12-10", "period": "monthly", "dueDay": 1},
     "through": "2027-03-01",
     "expect": [
       {"periodFrom": "2026-11-01", "periodTo": "2026-11-30", "dueDayKey": "2026-11-01"},
       {"periodFrom": "2026-12-01", "periodTo": "2026-12-31", "dueDayKey": "2026-12-01"}]},
    {"name": "monthly: nothing before the start",
     "assignment": {"startDayKey": "2026-11-01", "endDayKey": null, "period": "monthly", "dueDay": 1},
     "through": "2026-10-31",
     "expect": []},
    {"name": "weekly: Monday start, due Monday",
     "assignment": {"startDayKey": "2026-11-09", "endDayKey": null, "period": "weekly", "dueDay": 1},
     "through": "2026-11-24",
     "expect": [
       {"periodFrom": "2026-11-09", "periodTo": "2026-11-15", "dueDayKey": "2026-11-09"},
       {"periodFrom": "2026-11-16", "periodTo": "2026-11-22", "dueDayKey": "2026-11-16"},
       {"periodFrom": "2026-11-23", "periodTo": "2026-11-29", "dueDayKey": "2026-11-23"}]},
    {"name": "weekly: Wednesday start, due Monday falls in the next week",
     "assignment": {"startDayKey": "2026-11-11", "endDayKey": null, "period": "weekly", "dueDay": 1},
     "through": "2026-11-12",
     "expect": [
       {"periodFrom": "2026-11-11", "periodTo": "2026-11-17", "dueDayKey": "2026-11-16"}]},
    {"name": "weekly: due Sunday, across the end of February",
     "assignment": {"startDayKey": "2027-02-22", "endDayKey": null, "period": "weekly", "dueDay": 7},
     "through": "2027-03-02",
     "expect": [
       {"periodFrom": "2027-02-22", "periodTo": "2027-02-28", "dueDayKey": "2027-02-28"},
       {"periodFrom": "2027-03-01", "periodTo": "2027-03-07", "dueDayKey": "2027-03-07"}]}
  ],
  "billCases": [
    {"name": "monthly rent bill shape and label",
     "assignment": {"id": "as1", "businessId": "biz1", "driverId": "d1", "carId": "c1", "startDayKey": "2026-11-01", "endDayKey": null, "period": "monthly", "dueDay": 1, "rentCents": 90000},
     "existing": [], "through": "2026-11-20", "settings": {},
     "expect": [
       {"id": "as1_2026-11-01", "businessId": "biz1", "driverId": "d1", "carId": "c1", "assignmentId": "as1", "kind": "rent", "label": "Plate fee Nov 2026", "periodFrom": "2026-11-01", "periodTo": "2026-11-30", "dueDayKey": "2026-11-01", "amountCents": 90000, "paidCents": 0, "status": "open"}]},
    {"name": "weekly rent bill label is US month-first",
     "assignment": {"id": "as2", "businessId": "biz1", "driverId": "d2", "carId": "c2", "startDayKey": "2026-11-09", "endDayKey": null, "period": "weekly", "dueDay": 1, "rentCents": 35000},
     "existing": [], "through": "2026-11-09", "settings": {},
     "expect": [
       {"id": "as2_2026-11-09", "businessId": "biz1", "driverId": "d2", "carId": "c2", "assignmentId": "as2", "kind": "rent", "label": "Plate fee week of Nov 9, 2026", "periodFrom": "2026-11-09", "periodTo": "2026-11-15", "dueDayKey": "2026-11-09", "amountCents": 35000, "paidCents": 0, "status": "open"}]},
    {"name": "existing bills are skipped (idempotent)",
     "assignment": {"id": "as1", "startDayKey": "2026-11-01", "endDayKey": null, "period": "monthly", "dueDay": 1, "rentCents": 90000},
     "existing": ["as1_2026-11-01"], "through": "2026-12-05", "settings": {},
     "expectIds": ["as1_2026-12-01"]},
    {"name": "return mid-period, rule full: full rent",
     "assignment": {"id": "as3", "startDayKey": "2026-11-01", "endDayKey": "2026-11-10", "period": "monthly", "dueDay": 1, "rentCents": 90000},
     "existing": [], "through": "2026-12-31", "settings": {"returnRule": "full"},
     "expectAmounts": [90000]},
    {"name": "return mid-period, rule days: 10 of 30 days",
     "assignment": {"id": "as3", "startDayKey": "2026-11-01", "endDayKey": "2026-11-10", "period": "monthly", "dueDay": 1, "rentCents": 90000},
     "existing": [], "through": "2026-12-31", "settings": {"returnRule": "days"},
     "expectAmounts": [30000]},
    {"name": "return mid-period, no setting: defaults to full",
     "assignment": {"id": "as3", "startDayKey": "2026-11-01", "endDayKey": "2026-11-10", "period": "monthly", "dueDay": 1, "rentCents": 90000},
     "existing": [], "through": "2026-12-31", "settings": {},
     "expectAmounts": [90000]},
    {"name": "return on the last day of the period, rule days: full rent",
     "assignment": {"id": "as3", "startDayKey": "2026-11-01", "endDayKey": "2026-11-30", "period": "monthly", "dueDay": 1, "rentCents": 90000},
     "existing": [], "through": "2026-12-31", "settings": {"returnRule": "days"},
     "expectAmounts": [90000]},
    {"name": "return mid-week, rule days: 3 of 7 days, rounded",
     "assignment": {"id": "as4", "startDayKey": "2026-11-09", "endDayKey": "2026-11-11", "period": "weekly", "dueDay": 1, "rentCents": 35001},
     "existing": [], "through": "2026-12-31", "settings": {"returnRule": "days"},
     "expectAmounts": [15000]},
    {"name": "return in February, rule days: 14 of 28 days",
     "assignment": {"id": "as5", "startDayKey": "2027-02-01", "endDayKey": "2027-02-14", "period": "monthly", "dueDay": 1, "rentCents": 100000},
     "existing": [], "through": "2027-03-31", "settings": {"returnRule": "days"},
     "expectAmounts": [50000]}
  ],
  "lateFeeCases": [
    {"name": "fee day passed: one fee, due on the fee day",
     "settings": {"lateFee": {"cents": 5000, "dayOfMonth": 5, "firstMonth": "2026-11"}},
     "today": "2026-11-05",
     "bills": [{"id": "b1", "kind": "rent", "status": "open", "amountCents": 90000, "paidCents": 0, "dueDayKey": "2026-11-01", "label": "Plate fee Nov 2026", "driverId": "d1"}],
     "expect": [{"id": "b1_late", "kind": "late_fee", "amountCents": 5000, "lateFeeForBillId": "b1", "dueDayKey": "2026-11-05", "label": "Late fee — Plate fee Nov 2026", "driverId": "d1"}]},
    {"name": "before the fee day: nothing",
     "settings": {"lateFee": {"cents": 5000, "dayOfMonth": 5, "firstMonth": "2026-11"}},
     "today": "2026-11-04",
     "bills": [{"id": "b1", "kind": "rent", "status": "open", "amountCents": 90000, "paidCents": 0, "dueDayKey": "2026-11-01", "label": "Plate fee Nov 2026"}],
     "expect": []},
    {"name": "a fee already exists (even waived): no second fee",
     "settings": {"lateFee": {"cents": 5000, "dayOfMonth": 5, "firstMonth": "2026-11"}},
     "today": "2026-11-20",
     "bills": [
       {"id": "b1", "kind": "rent", "status": "open", "amountCents": 90000, "paidCents": 0, "dueDayKey": "2026-11-01", "label": "Plate fee Nov 2026"},
       {"id": "b1_late", "kind": "late_fee", "status": "waived", "amountCents": 5000, "paidCents": 0, "dueDayKey": "2026-11-05", "lateFeeForBillId": "b1"}],
     "expect": []},
    {"name": "before firstMonth: no fee",
     "settings": {"lateFee": {"cents": 5000, "dayOfMonth": 5, "firstMonth": "2026-12"}},
     "today": "2026-12-20",
     "bills": [{"id": "b1", "kind": "rent", "status": "open", "amountCents": 90000, "paidCents": 0, "dueDayKey": "2026-11-01", "label": "Plate fee Nov 2026"}],
     "expect": []},
    {"name": "waived, void, paid and fully paid rent bills get no fee",
     "settings": {"lateFee": {"cents": 5000, "dayOfMonth": 5, "firstMonth": "2026-11"}},
     "today": "2026-11-20",
     "bills": [
       {"id": "w", "kind": "rent", "status": "waived", "amountCents": 90000, "paidCents": 0, "dueDayKey": "2026-11-01"},
       {"id": "v", "kind": "rent", "status": "void", "amountCents": 90000, "paidCents": 0, "dueDayKey": "2026-11-01"},
       {"id": "p", "kind": "rent", "status": "paid", "amountCents": 90000, "paidCents": 90000, "dueDayKey": "2026-11-01"},
       {"id": "f", "kind": "rent", "status": "open", "amountCents": 90000, "paidCents": 90000, "dueDayKey": "2026-11-01"},
       {"id": "c", "kind": "charge", "status": "open", "amountCents": 1000, "paidCents": 0, "dueDayKey": "2026-11-01"}],
     "expect": []},
    {"name": "bill due after the fee day: not yet on the next fee day's eve",
     "settings": {"lateFee": {"cents": 5000, "dayOfMonth": 5, "firstMonth": "2026-11"}},
     "today": "2026-12-04",
     "bills": [{"id": "wk", "kind": "rent", "status": "open", "amountCents": 35000, "paidCents": 0, "dueDayKey": "2026-11-23", "label": "Plate fee week of Nov 23, 2026"}],
     "expect": []},
    {"name": "bill due after the fee day: fee on the next month's fee day",
     "settings": {"lateFee": {"cents": 5000, "dayOfMonth": 5, "firstMonth": "2026-11"}},
     "today": "2026-12-05",
     "bills": [{"id": "wk", "kind": "rent", "status": "open", "amountCents": 35000, "paidCents": 0, "dueDayKey": "2026-11-23", "label": "Plate fee week of Nov 23, 2026"}],
     "expect": [{"id": "wk_late", "dueDayKey": "2026-12-05", "amountCents": 5000, "label": "Late fee — Plate fee week of Nov 23, 2026"}]},
    {"name": "fee of zero cents: none",
     "settings": {"lateFee": {"cents": 0, "dayOfMonth": 5, "firstMonth": "2026-11"}},
     "today": "2026-11-20",
     "bills": [{"id": "b1", "kind": "rent", "status": "open", "amountCents": 90000, "paidCents": 0, "dueDayKey": "2026-11-01"}],
     "expect": []},
    {"name": "part-paid bill still earns a fee",
     "settings": {"lateFee": {"cents": 2500, "dayOfMonth": 10, "firstMonth": "2026-11"}},
     "today": "2026-11-10",
     "bills": [{"id": "b1", "kind": "rent", "status": "open", "amountCents": 90000, "paidCents": 40000, "dueDayKey": "2026-11-01", "label": "Plate fee Nov 2026"}],
     "expect": [{"id": "b1_late", "amountCents": 2500, "dueDayKey": "2026-11-10"}]}
  ],
  "allocationCases": [
    {"name": "late fee first, then oldest due, overpay to credit",
     "bills": [
       {"id": "r1", "kind": "rent", "status": "open", "amountCents": 90000, "paidCents": 0, "dueDayKey": "2026-10-01"},
       {"id": "r2", "kind": "rent", "status": "open", "amountCents": 90000, "paidCents": 0, "dueDayKey": "2026-11-01"},
       {"id": "r2_late", "kind": "late_fee", "status": "open", "amountCents": 5000, "paidCents": 0, "dueDayKey": "2026-11-05"}],
     "amountCents": 200000,
     "expect": {"ok": true, "allocations": [{"billId": "r2_late", "cents": 5000}, {"billId": "r1", "cents": 90000}, {"billId": "r2", "cents": 90000}], "creditAddedCents": 15000}},
    {"name": "partial payment pays the late fee then part of the oldest",
     "bills": [
       {"id": "r1", "kind": "rent", "status": "open", "amountCents": 90000, "paidCents": 10000, "dueDayKey": "2026-10-01"},
       {"id": "r2", "kind": "rent", "status": "open", "amountCents": 90000, "paidCents": 0, "dueDayKey": "2026-11-01"},
       {"id": "r2_late", "kind": "late_fee", "status": "open", "amountCents": 5000, "paidCents": 0, "dueDayKey": "2026-11-05"}],
     "amountCents": 50000,
     "expect": {"ok": true, "allocations": [{"billId": "r2_late", "cents": 5000}, {"billId": "r1", "cents": 45000}], "creditAddedCents": 0}},
    {"name": "same due day orders by id; paid and waived bills are skipped",
     "bills": [
       {"id": "b", "kind": "charge", "status": "open", "amountCents": 1000, "paidCents": 0, "dueDayKey": "2026-11-01"},
       {"id": "a", "kind": "rent", "status": "open", "amountCents": 1000, "paidCents": 0, "dueDayKey": "2026-11-01"},
       {"id": "x", "kind": "rent", "status": "waived", "amountCents": 1000, "paidCents": 0, "dueDayKey": "2026-10-01"},
       {"id": "y", "kind": "rent", "status": "paid", "amountCents": 1000, "paidCents": 1000, "dueDayKey": "2026-10-01"}],
     "amountCents": 1500,
     "expect": {"ok": true, "allocations": [{"billId": "a", "cents": 1000}, {"billId": "b", "cents": 500}], "creditAddedCents": 0}},
    {"name": "no open bills: everything becomes credit",
     "bills": [],
     "amountCents": 7000,
     "expect": {"ok": true, "allocations": [], "creditAddedCents": 7000}},
    {"name": "zero amount refuses",
     "bills": [],
     "amountCents": 0,
     "expect": {"ok": false, "reason": "fleet_no_amount"}},
    {"name": "negative amount refuses",
     "bills": [],
     "amountCents": -5,
     "expect": {"ok": false, "reason": "fleet_no_amount"}}
  ],
  "creditCases": [
    {"name": "credit covers the late fee and part of the next bill",
     "bills": [
       {"id": "r1", "kind": "rent", "status": "open", "amountCents": 90000, "paidCents": 0, "dueDayKey": "2026-11-01"},
       {"id": "r1_late", "kind": "late_fee", "status": "open", "amountCents": 5000, "paidCents": 0, "dueDayKey": "2026-11-05"}],
     "creditCents": 20000,
     "expect": {"allocations": [{"billId": "r1_late", "cents": 5000}, {"billId": "r1", "cents": 15000}], "creditLeftCents": 0}},
    {"name": "credit larger than the debt keeps the rest",
     "bills": [{"id": "r1", "kind": "rent", "status": "open", "amountCents": 9000, "paidCents": 0, "dueDayKey": "2026-11-01"}],
     "creditCents": 12000,
     "expect": {"allocations": [{"billId": "r1", "cents": 9000}], "creditLeftCents": 3000}},
    {"name": "no credit: nothing applied",
     "bills": [{"id": "r1", "kind": "rent", "status": "open", "amountCents": 9000, "paidCents": 0, "dueDayKey": "2026-11-01"}],
     "creditCents": 0,
     "expect": {"allocations": [], "creditLeftCents": 0}}
  ],
  "balanceCases": [
    {"name": "late, upcoming, waived and void bills",
     "today": "2026-11-10",
     "creditCents": 2500,
     "bills": [
       {"id": "r1", "kind": "rent", "status": "open", "amountCents": 90000, "paidCents": 30000, "dueDayKey": "2026-11-01"},
       {"id": "r1_late", "kind": "late_fee", "status": "open", "amountCents": 5000, "paidCents": 0, "dueDayKey": "2026-11-05"},
       {"id": "r2", "kind": "rent", "status": "open", "amountCents": 90000, "paidCents": 0, "dueDayKey": "2026-12-01"},
       {"id": "r3", "kind": "charge", "status": "open", "amountCents": 1000, "paidCents": 0, "dueDayKey": "2026-12-01"},
       {"id": "w", "kind": "late_fee", "status": "waived", "amountCents": 5000, "paidCents": 0, "dueDayKey": "2026-10-05"},
       {"id": "v", "kind": "rent", "status": "void", "amountCents": 90000, "paidCents": 0, "dueDayKey": "2026-10-01"},
       {"id": "p", "kind": "rent", "status": "paid", "amountCents": 90000, "paidCents": 90000, "dueDayKey": "2026-09-01"}],
     "expect": {"owedCents": 156000, "lateCents": 65000, "nextDue": {"dueDayKey": "2026-12-01", "cents": 91000}, "creditCents": 2500}},
    {"name": "due today is not late",
     "today": "2026-11-01",
     "creditCents": 0,
     "bills": [{"id": "r1", "kind": "rent", "status": "open", "amountCents": 90000, "paidCents": 0, "dueDayKey": "2026-11-01"}],
     "expect": {"owedCents": 90000, "lateCents": 0, "nextDue": {"dueDayKey": "2026-11-01", "cents": 90000}, "creditCents": 0}},
    {"name": "nothing owed",
     "today": "2026-11-01",
     "creditCents": 100,
     "bills": [],
     "expect": {"owedCents": 0, "lateCents": 0, "nextDue": null, "creditCents": 100}}
  ],
  "personalCases": [
    {"name": "keep valid values, fill the lowest free, oldest first",
     "drivers": [
       {"id": "d3", "personalCents": null, "createdAt": 300},
       {"id": "d1", "personalCents": 2, "createdAt": 100},
       {"id": "d2", "personalCents": null, "createdAt": 200},
       {"id": "d4", "personalCents": 5, "createdAt": 400}],
     "expect": {"d1": 2, "d2": 1, "d3": 3, "d4": 5}},
    {"name": "duplicates and out-of-range values are reassigned",
     "drivers": [
       {"id": "a", "personalCents": 7, "createdAt": 1},
       {"id": "b", "personalCents": 7, "createdAt": 2},
       {"id": "c", "personalCents": 0, "createdAt": 3},
       {"id": "d", "personalCents": 100, "createdAt": 4},
       {"id": "e", "personalCents": 1.5, "createdAt": 5}],
     "expect": {"a": 7, "b": 1, "c": 2, "d": 3, "e": 4}},
    {"name": "same createdAt orders by id",
     "drivers": [
       {"id": "y", "personalCents": null, "createdAt": 10},
       {"id": "x", "personalCents": null, "createdAt": 10}],
     "expect": {"x": 1, "y": 2}}
  ]
}
