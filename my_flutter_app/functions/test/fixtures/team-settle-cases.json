{
  "description": "I paid everything (docs/TEAM_SETTLE.md): how one amount is split for the scope the payer chose. Statement = parking and jobs - expenses + cash held. Run by the server (test/team-settle.test.js) and the console (admin_web/src/lib/team-settle.test.ts).",
  "plans": [
    {
      "name": "everything: the cash they hold first, then their own parking",
      "statement": {"parkingJobsCents": 122600, "expenseCents": 3500, "cashHeldCents": 3600},
      "amountCents": 122700, "scope": "everything",
      "expected": {"ok": true, "reason": "", "cashCents": 3600, "parkingCents": 119100, "leftCents": 0}
    },
    {
      "name": "everything, a smaller amount: all of it goes to the cash first",
      "statement": {"parkingJobsCents": 122600, "expenseCents": 3500, "cashHeldCents": 3600},
      "amountCents": 2000, "scope": "everything",
      "expected": {"ok": true, "reason": "", "cashCents": 2000, "parkingCents": 0, "leftCents": 120700}
    },
    {
      "name": "everything: the cash is covered, the rest reaches the parking",
      "statement": {"parkingJobsCents": 50000, "expenseCents": 0, "cashHeldCents": 10000},
      "amountCents": 25000, "scope": "everything",
      "expected": {"ok": true, "reason": "", "cashCents": 10000, "parkingCents": 15000, "leftCents": 35000}
    },
    {
      "name": "only the cash I hold",
      "statement": {"parkingJobsCents": 50000, "expenseCents": 0, "cashHeldCents": 10000},
      "amountCents": 10000, "scope": "cash",
      "expected": {"ok": true, "reason": "", "cashCents": 10000, "parkingCents": 0, "leftCents": 50000}
    },
    {
      "name": "only my parking",
      "statement": {"parkingJobsCents": 50000, "expenseCents": 20000, "cashHeldCents": 10000},
      "amountCents": 30000, "scope": "parking",
      "expected": {"ok": true, "reason": "", "cashCents": 0, "parkingCents": 30000, "leftCents": 10000}
    },
    {
      "name": "only the cash: more than they hold is refused",
      "statement": {"parkingJobsCents": 50000, "expenseCents": 0, "cashHeldCents": 10000},
      "amountCents": 10001, "scope": "cash",
      "expected": {"ok": false, "reason": "team_settle_more_than_owed", "cashCents": 0, "parkingCents": 0, "leftCents": 60000}
    },
    {
      "name": "only the parking: more than the bill after expenses is refused",
      "statement": {"parkingJobsCents": 50000, "expenseCents": 20000, "cashHeldCents": 10000},
      "amountCents": 30001, "scope": "parking",
      "expected": {"ok": false, "reason": "team_settle_more_than_owed", "cashCents": 0, "parkingCents": 0, "leftCents": 40000}
    },
    {
      "name": "everything: more than the statement is refused",
      "statement": {"parkingJobsCents": 50000, "expenseCents": 20000, "cashHeldCents": 10000},
      "amountCents": 40001, "scope": "everything",
      "expected": {"ok": false, "reason": "team_settle_more_than_owed", "cashCents": 0, "parkingCents": 0, "leftCents": 40000}
    },
    {
      "name": "expenses beyond the bill cut the cash they owe, so everything never exceeds the statement",
      "statement": {"parkingJobsCents": 10000, "expenseCents": 30000, "cashHeldCents": 50000},
      "amountCents": 30000, "scope": "everything",
      "expected": {"ok": true, "reason": "", "cashCents": 30000, "parkingCents": 0, "leftCents": 0}
    },
    {
      "name": "a zero or negative amount is refused",
      "statement": {"parkingJobsCents": 50000, "expenseCents": 0, "cashHeldCents": 10000},
      "amountCents": 0, "scope": "everything",
      "expected": {"ok": false, "reason": "team_settle_no_amount", "cashCents": 0, "parkingCents": 0, "leftCents": 60000}
    },
    {
      "name": "a fraction of a cent is refused",
      "statement": {"parkingJobsCents": 50000, "expenseCents": 0, "cashHeldCents": 10000},
      "amountCents": 10.5, "scope": "everything",
      "expected": {"ok": false, "reason": "team_settle_no_amount", "cashCents": 0, "parkingCents": 0, "leftCents": 60000}
    },
    {
      "name": "nothing owed: refused",
      "statement": {"parkingJobsCents": 0, "expenseCents": 0, "cashHeldCents": 0},
      "amountCents": 100, "scope": "everything",
      "expected": {"ok": false, "reason": "team_settle_nothing_owed", "cashCents": 0, "parkingCents": 0, "leftCents": 0}
    },
    {
      "name": "no cash held: only the cash is nothing owed, but everything still pays the parking",
      "statement": {"parkingJobsCents": 8000, "expenseCents": 0, "cashHeldCents": 0},
      "amountCents": 8000, "scope": "everything",
      "expected": {"ok": true, "reason": "", "cashCents": 0, "parkingCents": 8000, "leftCents": 0}
    },
    {
      "name": "no cash held: only the cash is refused as nothing owed",
      "statement": {"parkingJobsCents": 8000, "expenseCents": 0, "cashHeldCents": 0},
      "amountCents": 100, "scope": "cash",
      "expected": {"ok": false, "reason": "team_settle_nothing_owed", "cashCents": 0, "parkingCents": 0, "leftCents": 8000}
    },
    {
      "name": "the business owes them (negative statement): nothing to pay",
      "statement": {"parkingJobsCents": 0, "expenseCents": 5000, "cashHeldCents": 0},
      "amountCents": 100, "scope": "everything",
      "expected": {"ok": false, "reason": "team_settle_nothing_owed", "cashCents": 0, "parkingCents": 0, "leftCents": 0}
    },
    {
      "name": "an unknown scope is refused",
      "statement": {"parkingJobsCents": 50000, "expenseCents": 0, "cashHeldCents": 10000},
      "amountCents": 100, "scope": "other",
      "expected": {"ok": false, "reason": "team_settle_scope_invalid", "cashCents": 0, "parkingCents": 0, "leftCents": 60000}
    },
    {
      "name": "explicit cash held and parking due are used as given",
      "statement": {"parkingJobsCents": 999999, "expenseCents": 0, "cashHeldCents": 999999},
      "cashHeldCents": 1000, "parkingDueCents": 2000,
      "amountCents": 2500, "scope": "everything",
      "expected": {"ok": true, "reason": "", "cashCents": 1000, "parkingCents": 1500, "leftCents": 500}
    }
  ],
  "defaults": [
    {"name": "the default is the statement's number", "statement": {"parkingJobsCents": 122600, "expenseCents": 3500, "cashHeldCents": 3600}, "expected": 122700},
    {"name": "expenses beyond the bill", "statement": {"parkingJobsCents": 10000, "expenseCents": 30000, "cashHeldCents": 50000}, "expected": 30000},
    {"name": "the business owes them", "statement": {"parkingJobsCents": 0, "expenseCents": 5000, "cashHeldCents": 0}, "expected": 0}
  ],
  "paybacks": [
    {"name": "the business owes $50: paying it back is fine", "owesCents": -5000, "amountCents": 5000, "method": "zelle", "expected": ""},
    {"name": "part of it", "owesCents": -5000, "amountCents": 1000, "method": "cash", "expected": ""},
    {"name": "more than owed", "owesCents": -5000, "amountCents": 5001, "method": "cash", "expected": "team_payback_more_than_owed"},
    {"name": "the statement is not negative", "owesCents": 0, "amountCents": 100, "method": "cash", "expected": "team_payback_not_owed"},
    {"name": "bad method", "owesCents": -5000, "amountCents": 100, "method": "bitcoin", "expected": "team_settle_method_invalid"},
    {"name": "no amount", "owesCents": -5000, "amountCents": 0, "method": "cash", "expected": "team_settle_no_amount"}
  ]
}
