{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "test": "npm run test:unit && npm run test:shared-barrel && npm run test:support && npm run test:rules",
    "test:unit": "node --test test/business-car-backfill.test.js test/business-verification.test.js test/featured-business.test.js test/payment-config.test.js test/shared-barrel.test.js test/support-case-contract.test.js",
    "test:shared-barrel": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-laawol-shared-barrels \"node test/shared-barrel-callables.test.js\"",
    "test:support": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-laawol-support \"node test/support-case-callables.test.js\"",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore,storage --project demo-laawol-rules \"node test/firestore-rules.test.js\"",
    "seed:support-emulator": "node scripts/seed-support-emulator.js",
    "backfill:cars": "node scripts/backfill-business-car-listings.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.0.1"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0"
  },
  "private": true
}
