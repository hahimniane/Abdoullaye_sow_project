rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if a user is an admin
    function isAdmin(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.role == 'admin';
    }

    // Helper function to check if a user is staff or admin
    function isStaffOrAdmin(userId) {
      let userRole = get(/databases/$(database)/documents/users/$(userId)).data.role;
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             (userRole == 'staff' || userRole == 'admin');
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow users to read their own data
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to create their own user document
      allow create: if request.auth != null && request.auth.uid == userId &&
                      request.resource.data.role == 'customer';

      // Allow admins to read any user's data
      allow read: if request.auth != null && isAdmin(request.auth.uid);
      
      // Allow admins to update any user's role
      allow update: if request.auth != null && isAdmin(request.auth.uid) &&
                      'role' in request.resource.data &&
                      request.resource.data.role in ['customer', 'staff', 'admin'];

      // Prevent users from updating their own role directly
      allow update: if request.auth != null && request.auth.uid == userId &&
                      request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['fullName', 'phone', 'updatedAt']);
    }

    // Rules for the 'parkedCars' collection
    match /parkedCars/{carId} {
      // Allow only staff and admins to create, read, and update parking records
      allow read, write: if request.auth != null && isStaffOrAdmin(request.auth.uid);
    }

    match /barrelShipments/{shipmentId} {
      allow read, write: if request.auth != null && isStaffOrAdmin(request.auth.uid);
      allow read: if request.auth != null &&
        resource.data.customerUid == request.auth.uid;
    }

    match /transportRequests/{requestId} {
      allow read, write: if request.auth != null && isStaffOrAdmin(request.auth.uid);
    }

    match /cars/{carId} {
      allow read: if true;
      allow write: if request.auth != null && isStaffOrAdmin(request.auth.uid);
    }

    match /destinationCountries/{countryId} {
      allow read: if true;
      allow write: if request.auth != null && isStaffOrAdmin(request.auth.uid);
    }

    match /shipmentPricing/{pricingId} {
      allow read: if true;
      allow write: if request.auth != null && isStaffOrAdmin(request.auth.uid);
    }

    match /carPurchases/{purchaseId} {
      allow create: if request.auth != null &&
        request.resource.data.buyerUid == request.auth.uid;
      allow read: if request.auth != null &&
        resource.data.buyerUid == request.auth.uid;
      allow read: if request.auth != null &&
        isStaffOrAdmin(request.auth.uid);
      allow update: if request.auth != null && isStaffOrAdmin(request.auth.uid);
      allow delete: if request.auth != null && isStaffOrAdmin(request.auth.uid);
    }
  }
} 
