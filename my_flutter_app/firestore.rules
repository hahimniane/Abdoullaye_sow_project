rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if a user is an admin
    function isAdmin(userId) {
      return request.auth != null &&
             request.auth.uid == userId &&
             request.auth.token.email_verified == true &&
             exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.role == 'admin' &&
             userAccessAllowed(userId);
    }

    function isSuperAdmin(userId) {
      return isAdmin(userId) &&
             get(/databases/$(database)/documents/users/$(userId))
               .data.get('adminRole', '') == 'superAdmin';
    }

    function userProfile(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function userRole(userId) {
      return userProfile(userId).role;
    }

    function userBusinessId(userId) {
      return userProfile(userId).businessId;
    }

    function userAdminRole(userId) {
      return userProfile(userId).get('adminRole', '') is string ?
        userProfile(userId).get('adminRole', '') :
        "";
    }

    function userAccessAllowed(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        !(
          get(/databases/$(database)/documents/users/$(userId))
            .data.get('accountStatus', 'active') in [
              'suspended',
              'deleting',
              'deleted'
            ]
        );
    }

    function hasConfiguredAdminRole(userId) {
      return exists(/databases/$(database)/documents/platformConfig/permissions) &&
        userAdminRole(userId) in get(/databases/$(database)/documents/platformConfig/permissions)
          .data.get('roles', {});
    }

    function hasDynamicAdminCapability(userId, section) {
      return exists(/databases/$(database)/documents/platformConfig/permissions) &&
        userAdminRole(userId) in get(/databases/$(database)/documents/platformConfig/permissions)
          .data.roles &&
        get(/databases/$(database)/documents/platformConfig/permissions)
          .data.roles[userAdminRole(userId)].sections is map &&
        section in get(/databases/$(database)/documents/platformConfig/permissions)
          .data.roles[userAdminRole(userId)].sections &&
        get(/databases/$(database)/documents/platformConfig/permissions)
          .data.roles[userAdminRole(userId)].sections[section] == 'manage';
    }

    function hasBuiltInAdminCapability(userId, section) {
      return isSuperAdmin(userId) ||
        (
          !hasConfiguredAdminRole(userId) &&
          userAdminRole(userId) == 'operationsManager' &&
          section in ['businesses', 'marketplace', 'operations', 'support', 'website']
        ) ||
        (
          !hasConfiguredAdminRole(userId) &&
          userAdminRole(userId) == 'financeManager' &&
          section in ['finance', 'support']
        ) ||
        (
          !hasConfiguredAdminRole(userId) &&
          userAdminRole(userId) == 'supportAdmin' &&
          section == 'support'
        ) ||
        (
          !hasConfiguredAdminRole(userId) &&
          userAdminRole(userId) == 'contentManager' &&
          section == 'website'
        );
    }

    function hasAdminCapability(userId, section) {
      return isAdmin(userId) &&
        (hasBuiltInAdminCapability(userId, section) ||
         hasDynamicAdminCapability(userId, section));
    }

    function hasDynamicAdminSectionAccess(userId, section) {
      return hasConfiguredAdminRole(userId) &&
        get(/databases/$(database)/documents/platformConfig/permissions)
          .data.roles[userAdminRole(userId)].sections is map &&
        section in get(/databases/$(database)/documents/platformConfig/permissions)
          .data.roles[userAdminRole(userId)].sections &&
        get(/databases/$(database)/documents/platformConfig/permissions)
          .data.roles[userAdminRole(userId)].sections[section] in [
            'view',
            'manage'
          ];
    }

    function hasBuiltInAdminSectionAccess(userId, section) {
      return isSuperAdmin(userId) ||
        (
          !hasConfiguredAdminRole(userId) &&
          userAdminRole(userId) == 'operationsManager' &&
          section in [
            'people',
            'businesses',
            'marketplace',
            'operations',
            'support',
            'website'
          ]
        ) ||
        (
          !hasConfiguredAdminRole(userId) &&
          userAdminRole(userId) == 'financeManager' &&
          section in ['people', 'operations', 'finance', 'support']
        ) ||
        (
          !hasConfiguredAdminRole(userId) &&
          userAdminRole(userId) == 'supportAdmin' &&
          section in [
            'people',
            'businesses',
            'marketplace',
            'operations',
            'support'
          ]
        ) ||
        (
          !hasConfiguredAdminRole(userId) &&
          userAdminRole(userId) == 'contentManager' &&
          section in ['people', 'businesses', 'website']
        );
    }

    function hasAdminSectionAccess(userId, section) {
      return isAdmin(userId) &&
        (
          hasDynamicAdminSectionAccess(userId, section) ||
          hasBuiltInAdminSectionAccess(userId, section)
        );
    }

    function canManageWebsite(userId) {
      return hasAdminCapability(userId, 'website');
    }

    function canManageSupport(userId) {
      return hasAdminCapability(userId, 'support');
    }

    // Helper function to check if a user is staff, business owner, or admin
    function isStaffOrAdmin(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             userAccessAllowed(userId) &&
             (userRole(userId) == 'staff' ||
              userRole(userId) == 'businessOwner' ||
              isSuperAdmin(userId));
    }

    function canManageBusiness(userId, businessId) {
      return isSuperAdmin(userId) ||
             (exists(/databases/$(database)/documents/users/$(userId)) &&
              userAccessAllowed(userId) &&
              (userRole(userId) == 'staff' ||
               userRole(userId) == 'businessOwner') &&
              userBusinessId(userId) == businessId);
    }

    function canManageBusinessSection(userId, businessId, section) {
      return isSuperAdmin(userId) ||
             (
               exists(/databases/$(database)/documents/users/$(userId)) &&
               userAccessAllowed(userId) &&
               userBusinessId(userId) == businessId &&
               (
                 userRole(userId) == 'businessOwner' ||
                 (
                   userRole(userId) == 'staff' &&
                   userProfile(userId).get('businessPermissions', []) is list &&
                   userProfile(userId).get('businessPermissions', []).size() > 0 &&
                   section in userProfile(userId).get('businessPermissions', [])
                 )
               )
             );
    }

    function isLegacyTransportRecord(data) {
      return data.get('flowVersion', 1) != 2;
    }

    function ownsTransportRequest(userId, requestId) {
      return request.auth != null &&
        request.auth.uid == userId &&
        exists(/databases/$(database)/documents/transportRequests/$(requestId)) &&
        get(/databases/$(database)/documents/transportRequests/$(requestId))
          .data.customerUid == userId;
    }

    // Each service (barrel/air/sea) has its own real-world transit time, so
    // each gets an independent, independently-optional min/max pair.
    function validServiceDeliveryEstimate(data, serviceKey) {
      let minKey = serviceKey + 'DeliveryEstimateMinDays';
      let maxKey = serviceKey + 'DeliveryEstimateMaxDays';
      return (
          data.get(minKey, null) == null &&
          data.get(maxKey, null) == null
        ) ||
        (
          data.get(minKey, null) is int &&
          data.get(maxKey, null) is int &&
          data.get(minKey, null) > 0 &&
          data.get(maxKey, null) >= data.get(minKey, null)
        );
    }

    function validDeliveryEstimate(data) {
      return validServiceDeliveryEstimate(data, 'barrelShipping') &&
        validServiceDeliveryEstimate(data, 'freightAir') &&
        validServiceDeliveryEstimate(data, 'freightSea');
    }

    function validDepartureDays(data, key) {
      let days = data.get(key, []);
      return days is list &&
        days.size() <= 7 &&
        days.hasOnly([
          'monday',
          'tuesday',
          'wednesday',
          'thursday',
          'friday',
          'saturday',
          'sunday'
        ]);
    }

    function hasDestinationServiceMap(data) {
      return data.get('serviceAvailability', null) is map;
    }

    function destinationServiceEnabled(data, key) {
      return hasDestinationServiceMap(data) &&
        data.get('serviceAvailability', {}).get(key, false) == true;
    }

    function hasCanonicalDestinationServiceMap(data) {
      return hasDestinationServiceMap(data) &&
        data.serviceAvailability.keys().hasAll([
          'barrelShipping',
          'freightAir',
          'freightSea',
          'carTransport'
        ]) &&
        data.serviceAvailability.keys().hasOnly([
          'barrelShipping',
          'freightAir',
          'freightSea',
          'carTransport'
        ]) &&
        data.serviceAvailability.barrelShipping is bool &&
        data.serviceAvailability.freightAir is bool &&
        data.serviceAvailability.freightSea is bool &&
        data.serviceAvailability.carTransport is bool;
    }

    function businessOffersDestinationService(businessId, serviceKey) {
      let services = get(
        /databases/$(database)/documents/businesses/$(businessId)
      ).data.get('enabledServices', []);
      return services is list && (
        (serviceKey == 'barrelShipping' && 'barrelShipping' in services) ||
        (
          (serviceKey == 'freightAir' || serviceKey == 'freightSea') &&
          'freight' in services
        ) ||
        (serviceKey == 'carTransport' && 'carTransport' in services)
      );
    }

    function destinationServicesMatchBusiness(data, businessId) {
      return
        (
          !destinationServiceEnabled(data, 'barrelShipping') ||
          businessOffersDestinationService(businessId, 'barrelShipping')
        ) &&
        (
          !destinationServiceEnabled(data, 'freightAir') ||
          businessOffersDestinationService(businessId, 'freightAir')
        ) &&
        (
          !destinationServiceEnabled(data, 'freightSea') ||
          businessOffersDestinationService(businessId, 'freightSea')
        ) &&
        (
          !destinationServiceEnabled(data, 'carTransport') ||
          businessOffersDestinationService(businessId, 'carTransport')
        );
    }

    function validDestinationServiceRates(data) {
      return
        data.get('barrelShippingPrice', 0) is number &&
        data.get('barrelShippingPrice', 0) >= 0 &&
        data.get('freightAirPricePerKg', 0) is number &&
        data.get('freightAirPricePerKg', 0) >= 0 &&
        data.get('freightSeaPricePerKg', 0) is number &&
        data.get('freightSeaPricePerKg', 0) >= 0 &&
        (
          !destinationServiceEnabled(data, 'barrelShipping') ||
          data.get('barrelShippingPrice', 0) > 0
        ) &&
        (
          !destinationServiceEnabled(data, 'freightAir') ||
          data.get('freightAirPricePerKg', 0) > 0
        ) &&
        (
          !destinationServiceEnabled(data, 'freightSea') ||
          data.get('freightSeaPricePerKg', 0) > 0
        );
    }

    function validDestinationServiceCoverage(data) {
      let hasService =
        destinationServiceEnabled(data, 'barrelShipping') ||
        destinationServiceEnabled(data, 'freightAir') ||
        destinationServiceEnabled(data, 'freightSea') ||
        destinationServiceEnabled(data, 'carTransport');
      return
        data.get('destinationCoverageVersion', 0) == 2 &&
        hasCanonicalDestinationServiceMap(data) &&
        data.isActive is bool &&
        data.isActive == hasService &&
        data.get('carTransportAvailable', false) ==
          destinationServiceEnabled(data, 'carTransport');
    }

    // A business can register more than one physical office/drop-off
    // location (e.g. separate branches), so this is a subcollection rather
    // than scalar fields on the business doc itself.
    function validOfficeLocation(data, businessId) {
      return data.businessId == businessId &&
        data.get('label', '') is string &&
        data.label.size() > 0 &&
        data.label.size() <= 80 &&
        data.get('address', '') is string &&
        data.address.size() > 0 &&
        data.address.size() <= 200 &&
        data.get('isActive', true) is bool;
    }

    function validUserRoleState(data) {
      return data.role == 'customer' ||
        data.role == 'admin' ||
        (
          (data.role == 'staff' || data.role == 'businessOwner') &&
          data.businessId is string &&
          data.businessId != '' &&
          data.businessName is string &&
          data.businessName != ''
        );
    }

    // Customer signup normally runs through createCustomerUser (Admin SDK),
    // but keep a narrow legacy fallback for clients that must create their own
    // minimal profile. Everything used for verification, authorization,
    // reliability, wallet balances, or payments is intentionally absent from
    // this allowlist and therefore remains server-authoritative.
    function validNewCustomerProfile(data) {
      return data.keys().hasOnly([
          'role',
          'email',
          'fullName',
          'phone',
          'profileImageUrl',
          'profileImagePath',
          'notificationPreferences'
        ]) &&
        data.role == 'customer' &&
        data.get('email', '') is string &&
        data.get('email', '') == request.auth.token.get('email', '') &&
        data.get('fullName', '') is string &&
        data.get('phone', '') is string &&
        data.get('profileImageUrl', '') is string &&
        data.get('profileImagePath', '') is string &&
        data.get('notificationPreferences', {}) is map;
    }

    function supportCaseData(caseId) {
      return get(/databases/$(database)/documents/supportCases/$(caseId)).data;
    }

    // NOTE: authorize purely from the case document + the caller's own profile.
    // We deliberately avoid an exists() on the case's participants subcollection
    // here: a subcollection exists() makes the rule un-evaluable for `list`
    // (collection) queries, which silently breaks the business and admin support
    // inbox queries (where('businessId'==) / where('escalationStatus'=='escalated')).
    // Every legitimate reader is already covered: the customer, business
    // owner/support staff (by businessId), and support admins.
    function canReadSupportCase(caseId, data) {
      return request.auth != null &&
        (
          data.customerUid == request.auth.uid ||
          canManageSupport(request.auth.uid) ||
          (
            data.businessId is string &&
            canManageBusinessSection(request.auth.uid, data.businessId, 'support')
          )
        );
    }

    match /appConfig/client {
      allow read: if true;
      allow write: if false;
    }

    // Platform configuration (e.g. editable role permissions matrix).
    // Any admin may read it (drives console gating); only super admins write.
    match /platformConfig/{configId} {
      allow read: if request.auth != null && isAdmin(request.auth.uid);
      allow write: if request.auth != null && isSuperAdmin(request.auth.uid);
    }

    match /websiteContent/{docId} {
      allow read: if true;
      allow write: if request.auth != null && canManageWebsite(request.auth.uid);
    }

    match /featuredBusinesses/{businessId} {
      allow read: if true;
      allow write: if request.auth != null && canManageWebsite(request.auth.uid);
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow users to read their own data
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to create their own user document
      allow create: if request.auth != null && request.auth.uid == userId &&
                      validNewCustomerProfile(request.resource.data);

      // People directory access is capability-scoped. Clients that only need
      // a redacted cross-platform directory should use listMarketplacePeople.
      allow read: if request.auth != null &&
        hasAdminSectionAccess(request.auth.uid, 'people');
      allow read: if request.auth != null &&
        resource.data.businessId is string &&
        canManageBusinessSection(
          request.auth.uid,
          resource.data.businessId,
          'people'
        );

      // Prevent users from updating their own role directly
      allow update: if request.auth != null && request.auth.uid == userId &&
                      request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly([
                          'fullName',
                          'phone',
                          'profileImageUrl',
                          'profileImagePath',
                          'notificationPreferences',
                          'updatedAt'
                        ]);

      match /favoriteCars/{carId} {
        allow read, create, update, delete: if request.auth != null &&
          request.auth.uid == userId;
      }

      match /barrelPools/{poolId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || isAdmin(request.auth.uid));
        allow create, update, delete: if false;
      }

      match /fcmTokens/{tokenId} {
        allow read, create, update, delete: if request.auth != null &&
          request.auth.uid == userId;
      }

      // Written only by backend Admin SDK notification dispatch; clients may
      // only read their own feed and toggle read state.
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['read', 'readAt']);
        allow create, delete: if false;
      }
    }

    match /phoneSignInAliases/{alias} {
      allow read, write: if false;
    }

    // Server-only abuse-prevention state for callable rate limits.
    match /callableRateLimits/{limitId} {
      allow read, write: if false;
    }

    // Server-only payment webhook deduplication and reconciliation state.
    match /stripeWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /paymentReconciliationFailures/{failureId} {
      allow read, write: if false;
    }

    // Rules for the 'parkedCars' collection
    match /parkedCars/{carId} {
      // Allow only staff and admins to create, read, and update parking records
      allow read: if request.auth != null &&
        (resource.data.customerUid == request.auth.uid ||
         isAdmin(request.auth.uid) ||
         canManageBusiness(request.auth.uid, resource.data.businessId));
      allow create: if request.auth != null &&
        (hasAdminCapability(request.auth.uid, 'operations') ||
         canManageBusinessSection(request.auth.uid, request.resource.data.businessId, 'parking'));
      allow update: if request.auth != null &&
        request.resource.data.businessId == resource.data.businessId &&
        (hasAdminCapability(request.auth.uid, 'operations') ||
         canManageBusinessSection(request.auth.uid, resource.data.businessId, 'parking'));
      allow delete: if request.auth != null &&
        (hasAdminCapability(request.auth.uid, 'operations') ||
         canManageBusinessSection(request.auth.uid, resource.data.businessId, 'parking'));
    }

    // A load that is "in transit" is inside a container, and the customer's
    // next question is always "where is it". The container number is the key
    // the carrier tracking API is built on, so without it the status is one
    // neither the customer nor support can act on. containerNumber is written
    // only by subscribeToContainerTracking (Admin SDK, so it bypasses these
    // rules and is not in any business's allowed key list) - the business
    // subscribes tracking first, then advances the status. Enforced here
    // rather than in the console because the console writes these documents
    // directly, so a UI-only check would be advisory.
    function containerReadyForTransit(existing, incoming) {
      return incoming.status != 'in_transit' ||
        (existing.get('containerNumber', '') is string &&
         existing.get('containerNumber', '').size() >= 4);
    }

    // Air freight has no container, so only sea is gated. A shipment with no
    // mode recorded predates the air/sea split and is left alone rather than
    // being blocked retroactively.
    function seaFreightContainerReady(existing, incoming) {
      return existing.get('mode', '') != 'sea' ||
        containerReadyForTransit(existing, incoming);
    }

    match /barrelShipments/{shipmentId} {
      allow read: if request.auth != null &&
        (isAdmin(request.auth.uid) ||
         canManageBusiness(request.auth.uid, resource.data.businessId));
      allow create: if request.auth != null &&
        (hasAdminCapability(request.auth.uid, 'operations') ||
         canManageBusinessSection(request.auth.uid, request.resource.data.businessId, 'barrels'));
      // Admins keep full update. A business may only progress fulfillment
      // (status / tracking / notes) — never the customer's price, fees, payment,
      // Stripe, or identity fields — and may not delete a customer's shipment.
      allow update: if request.auth != null &&
        hasAdminCapability(request.auth.uid, 'operations');
      allow update: if request.auth != null &&
        canManageBusinessSection(request.auth.uid, resource.data.businessId, 'barrels') &&
        request.resource.data.businessId == resource.data.businessId &&
        containerReadyForTransit(resource.data, request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'trackingNumber', 'trackingCode', 'staffNotes', 'statusUpdatedAt', 'updatedAt']);
      allow delete: if request.auth != null &&
        hasAdminCapability(request.auth.uid, 'operations');
      allow read: if request.auth != null &&
        resource.data.customerUid == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.customerUid == request.auth.uid &&
        (
          resource.data.pickupRequested != true ||
          !(resource.data.pickupDateTime is timestamp) ||
          resource.data.pickupDateTime > request.time
        ) &&
        resource.data.status == 'pending' &&
        request.resource.data.customerUid == resource.data.customerUid &&
        request.resource.data.price == resource.data.price &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.paymentStatus == resource.data.paymentStatus &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'senderName',
            'senderAddress',
            'pickupAddress',
            'pickupDateTime',
            'receiverName',
            'receiverPhone',
            'updatedAt'
          ]);

      // Milestone timeline for this shipment (staff-entered updates and, once
      // a container is subscribed for tracking, carrier-API events). Writes
      // are server-only (addShipmentTrackingMilestone / the tracking
      // webhook) so validation lives in one place, matching the reviews
      // subcollection pattern above.
      match /trackingEvents/{eventId} {
        allow read: if request.auth != null &&
          (
            isAdmin(request.auth.uid) ||
            canManageBusiness(
              request.auth.uid,
              get(/databases/$(database)/documents/barrelShipments/$(shipmentId)).data.businessId
            ) ||
            get(/databases/$(database)/documents/barrelShipments/$(shipmentId)).data.customerUid == request.auth.uid
          );
        allow create, update, delete: if false;
      }
    }

    match /barrelOrders/{orderId} {
      allow read: if request.auth != null &&
        (isAdmin(request.auth.uid) ||
         resource.data.customerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /freightShipments/{shipmentId} {
      allow read: if request.auth != null &&
        (isAdmin(request.auth.uid) ||
         canManageBusiness(request.auth.uid, resource.data.businessId));
      allow create: if request.auth != null &&
        (hasAdminCapability(request.auth.uid, 'operations') ||
         canManageBusinessSection(request.auth.uid, request.resource.data.businessId, 'freight'));
      // Admins keep full update. A business may only progress fulfillment
      // (status / tracking / notes) — never price, fees, payment, Stripe, or
      // identity fields — and may not delete a customer's shipment.
      allow update: if request.auth != null &&
        hasAdminCapability(request.auth.uid, 'operations');
      allow update: if request.auth != null &&
        canManageBusinessSection(request.auth.uid, resource.data.businessId, 'freight') &&
        request.resource.data.businessId == resource.data.businessId &&
        (
          !resource.data.keys().hasAny(['freightPricingVersion']) ||
          resource.data.freightPricingVersion != 2 ||
          !(request.resource.data.status in ['in_transit', 'ready_for_pickup', 'completed']) ||
          resource.data.priceSettlementStatus == 'settled'
        ) &&
        seaFreightContainerReady(resource.data, request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'trackingNumber', 'trackingCode', 'staffNotes', 'statusUpdatedAt', 'updatedAt']);
      allow delete: if request.auth != null &&
        hasAdminCapability(request.auth.uid, 'operations');
      allow read: if request.auth != null &&
        resource.data.customerUid == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.customerUid == request.auth.uid &&
        (
          resource.data.pickupRequested != true ||
          !(resource.data.pickupDateTime is timestamp) ||
          resource.data.pickupDateTime > request.time
        ) &&
        resource.data.status == 'pending' &&
        request.resource.data.customerUid == resource.data.customerUid &&
        request.resource.data.price == resource.data.price &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.paymentStatus == resource.data.paymentStatus &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'senderName',
            'senderAddress',
            'pickupAddress',
            'pickupDateTime',
            'receiverName',
            'receiverPhone',
            'updatedAt'
          ]);

      // Milestone timeline for this shipment - see the identical block under
      // barrelShipments above for the full rationale.
      match /trackingEvents/{eventId} {
        allow read: if request.auth != null &&
          (
            isAdmin(request.auth.uid) ||
            canManageBusiness(
              request.auth.uid,
              get(/databases/$(database)/documents/freightShipments/$(shipmentId)).data.businessId
            ) ||
            get(/databases/$(database)/documents/freightShipments/$(shipmentId)).data.customerUid == request.auth.uid
          );
        allow create, update, delete: if false;
      }
    }

    match /freightSettlements/{settlementId} {
      allow read: if request.auth != null &&
        (isAdmin(request.auth.uid) ||
         resource.data.customerUid == request.auth.uid ||
         canManageBusinessSection(
           request.auth.uid,
           resource.data.businessId,
           'freight'
         ));
      allow write: if false;

      match /paymentAttempts/{attemptId} {
        allow read: if request.auth != null &&
          (isAdmin(request.auth.uid) ||
           resource.data.customerUid == request.auth.uid ||
           canManageBusinessSection(
             request.auth.uid,
             resource.data.businessId,
             'freight'
           ));
        allow write: if false;
      }
    }

    match /openBarrels/{poolId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /barrelPools/{poolId} {
      allow read: if request.auth != null &&
        (
          isAdmin(request.auth.uid) ||
          canManageBusiness(request.auth.uid, resource.data.businessId) ||
          resource.data.createdByUid == request.auth.uid ||
          exists(/databases/$(database)/documents/barrelPools/$(poolId)/participants/$(request.auth.uid))
        );
      allow create, update, delete: if false;

      match /participants/{participantId} {
        allow read: if request.auth != null &&
          (
            participantId == request.auth.uid ||
            isAdmin(request.auth.uid) ||
            get(/databases/$(database)/documents/barrelPools/$(poolId)).data.createdByUid == request.auth.uid ||
            canManageBusiness(
              request.auth.uid,
              get(/databases/$(database)/documents/barrelPools/$(poolId)).data.businessId
            )
          );
        allow create, update, delete: if false;
      }
    }

    match /transportRequests/{requestId} {
      allow read: if request.auth != null &&
        (isAdmin(request.auth.uid) ||
         canManageBusiness(request.auth.uid, resource.data.businessId));
      allow create: if request.auth != null &&
        isLegacyTransportRecord(request.resource.data) &&
        (hasAdminCapability(request.auth.uid, 'operations') ||
         canManageBusinessSection(request.auth.uid, request.resource.data.businessId, 'transport'));
      allow update: if request.auth != null &&
        isLegacyTransportRecord(resource.data) &&
        isLegacyTransportRecord(request.resource.data) &&
        request.resource.data.businessId == resource.data.businessId &&
        (hasAdminCapability(request.auth.uid, 'operations') ||
         canManageBusinessSection(request.auth.uid, resource.data.businessId, 'transport'));
      allow delete: if request.auth != null &&
        isLegacyTransportRecord(resource.data) &&
        (hasAdminCapability(request.auth.uid, 'operations') ||
         canManageBusinessSection(request.auth.uid, resource.data.businessId, 'transport'));
      // Customers may read their own transport requests (for tracking) and
      // cancel one while it is still pending. Requests are created server-side
      // by the createTransportRequest function (Admin SDK), so no customer
      // create rule is needed here.
      allow read: if request.auth != null &&
        resource.data.customerUid == request.auth.uid;
      allow update: if request.auth != null &&
        isLegacyTransportRecord(resource.data) &&
        isLegacyTransportRecord(request.resource.data) &&
        resource.data.customerUid == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.customerUid == resource.data.customerUid &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.price == resource.data.price &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);
    }

    match /transportOpportunities/{opportunityId} {
      allow read: if request.auth != null &&
        (
          isAdmin(request.auth.uid) ||
          canManageBusinessSection(
            request.auth.uid,
            resource.data.businessId,
            'transport'
          ) ||
          ownsTransportRequest(request.auth.uid, resource.data.requestId)
        );
      allow create, update, delete: if false;
    }

    match /transportQuotes/{quoteId} {
      allow read: if request.auth != null &&
        (
          isAdmin(request.auth.uid) ||
          canManageBusinessSection(
            request.auth.uid,
            resource.data.businessId,
            'transport'
          ) ||
          ownsTransportRequest(request.auth.uid, resource.data.requestId)
        );
      allow create, update, delete: if false;
    }

    match /cars/{carId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.isRebuiltTitle is bool &&
        (hasAdminCapability(request.auth.uid, 'marketplace') ||
         canManageBusinessSection(request.auth.uid, request.resource.data.businessId, 'listings'));
      allow update: if request.auth != null &&
        request.resource.data.businessId == resource.data.businessId &&
        (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isRebuiltTitle']) ||
         request.resource.data.isRebuiltTitle is bool) &&
        (hasAdminCapability(request.auth.uid, 'marketplace') ||
         canManageBusinessSection(request.auth.uid, resource.data.businessId, 'listings'));
      allow delete: if request.auth != null &&
        (hasAdminCapability(request.auth.uid, 'marketplace') ||
         canManageBusinessSection(request.auth.uid, resource.data.businessId, 'listings'));
    }

    match /businesses/{businessId} {
      allow read: if request.auth != null &&
        canManageBusiness(request.auth.uid, businessId);
      allow create, update, delete: if request.auth != null &&
        isSuperAdmin(request.auth.uid);

      match /destinationCountries/{countryId} {
        allow read: if get(/databases/$(database)/documents/businesses/$(businessId)).data.status == 'approved' ||
          (request.auth != null && canManageBusiness(request.auth.uid, businessId));
        allow create, update: if request.auth != null &&
          canManageBusinessSection(request.auth.uid, businessId, 'destinations') &&
          request.resource.data.businessId == businessId &&
          request.resource.data.get('countryId', countryId) == countryId &&
          validDestinationServiceRates(request.resource.data) &&
          validDestinationServiceCoverage(request.resource.data) &&
          destinationServicesMatchBusiness(request.resource.data, businessId) &&
          validDeliveryEstimate(request.resource.data) &&
          validDepartureDays(request.resource.data, 'freightAirDepartureDays') &&
          validDepartureDays(request.resource.data, 'freightSeaDepartureDays');
        allow delete: if false;
      }

      match /officeLocations/{locationId} {
        allow read: if get(/databases/$(database)/documents/businesses/$(businessId)).data.status == 'approved' ||
          (request.auth != null && canManageBusiness(request.auth.uid, businessId));
        allow create, update: if request.auth != null &&
          canManageBusinessSection(request.auth.uid, businessId, 'profile') &&
          validOfficeLocation(request.resource.data, businessId);
        allow delete: if false;
      }

      // Customer reviews of a completed order. Fully public once the
      // business is approved (same openness as destinationCountries above),
      // so shoppers can see ratings/comments before booking. All writes go
      // through submitBusinessReview/flagBusinessReview/resolveFlaggedReview
      // (Admin SDK) so order-ownership, completed-status, and one-review-
      // per-order validation lives in one place, not duplicated in rules.
      match /reviews/{reviewId} {
        allow read: if get(/databases/$(database)/documents/businesses/$(businessId)).data.status == 'approved' ||
          (request.auth != null &&
           (canManageBusiness(request.auth.uid, businessId) ||
            resource.data.customerUid == request.auth.uid));
        allow create, update, delete: if false;

        match /flags/{flagUid} {
          allow read: if request.auth != null &&
            (canManageBusiness(request.auth.uid, businessId) || isAdmin(request.auth.uid));
          allow create, update, delete: if false;
        }
      }
    }

    match /destinationCountries/{countryId} {
      allow read: if true;
      allow write: if request.auth != null && isSuperAdmin(request.auth.uid);
    }

    match /{path=**}/officeLocations/{locationId} {
      allow read: if request.auth != null && isAdmin(request.auth.uid);
    }

    match /{path=**}/destinationCountries/{countryId} {
      allow read: if request.auth != null && isAdmin(request.auth.uid);
    }

    // The nested businesses/{businessId}/reviews/{reviewId} rule above only
    // authorizes queries scoped to one specific business (a direct
    // subcollection reference or a get()); it does NOT cover a true
    // collectionGroup('reviews') query spanning every business, which
    // Firestore only authorizes via this separate {path=**} form (same
    // pattern as officeLocations/destinationCountries above). This is what
    // makes both the admin flagged-reviews moderation queue and a mobile
    // customer's "which of my orders have I already reviewed" check work.
    match /{path=**}/reviews/{reviewId} {
      allow read: if request.auth != null &&
        ((isAdmin(request.auth.uid) && resource.data.moderationStatus == 'flagged') ||
         resource.data.customerUid == request.auth.uid);
    }

    match /businessApplications/{applicationId} {
      allow read: if request.auth != null &&
        (isAdmin(request.auth.uid) ||
         resource.data.applicantUid == request.auth.uid ||
         canManageBusiness(request.auth.uid, resource.data.businessId));
      allow write: if false;
    }

    match /platformNotifications/{notificationId} {
      allow read: if request.auth != null && isAdmin(request.auth.uid);
      allow update: if request.auth != null &&
        hasAdminCapability(request.auth.uid, 'support');
      allow create, delete: if false;
    }

    match /notificationDeliveries/{deliveryId} {
      allow read: if request.auth != null && isAdmin(request.auth.uid);
      allow create, update, delete: if false;
    }

    match /businessSupportRequests/{requestId} {
      allow read: if request.auth != null && isAdmin(request.auth.uid);
      allow update: if request.auth != null &&
        hasAdminCapability(request.auth.uid, 'support');
      allow read: if request.auth != null &&
        canManageBusiness(request.auth.uid, resource.data.businessId);
      allow create, delete: if false;
      allow update: if request.auth != null &&
        canManageBusiness(request.auth.uid, resource.data.businessId) &&
        canManageBusinessSection(request.auth.uid, resource.data.businessId, 'support') &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'businessResponse',
            'businessRespondedAt',
            'businessRespondedBy',
            'businessReadAt',
            'businessReadBy',
            'updatedAt'
          ]);
    }

    match /supportCases/{caseId} {
      allow read: if canReadSupportCase(caseId, resource.data);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        // Guard the optional `internal` flag: reading resource.data.internal
        // directly throws "Property internal is undefined" for `list` queries on
        // messages that omit the field (which is all of them today).
        allow read: if canReadSupportCase(caseId, supportCaseData(caseId)) &&
          resource.data.get('internal', false) != true;
        allow create, update, delete: if false;
      }

      match /timeline/{eventId} {
        allow read: if canReadSupportCase(caseId, supportCaseData(caseId)) &&
          resource.data.get('private', false) != true;
        allow create, update, delete: if false;
      }

      match /participants/{participantId} {
        allow read: if canReadSupportCase(caseId, supportCaseData(caseId));
        allow create, update, delete: if false;
      }

      match /internalNotes/{noteId} {
        allow read: if request.auth != null &&
          canManageSupport(request.auth.uid);
        allow create, update, delete: if false;
      }
    }

    match /businessInsights/{insightId} {
      allow read: if request.auth != null &&
        (isAdmin(request.auth.uid) ||
         canManageBusiness(request.auth.uid, resource.data.businessId));
      allow create, update, delete: if false;
    }

    match /businessSubscriptions/{subscriptionId} {
      allow read: if request.auth != null &&
        (isAdmin(request.auth.uid) ||
         canManageBusiness(request.auth.uid, resource.data.businessId));
      allow create, update, delete: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if request.auth != null && isSuperAdmin(request.auth.uid);
      allow create, update, delete: if false;
    }

    match /accessInvitations/{invitationId} {
      allow read, create, update, delete: if false;
    }

    match /deletedUserTombstones/{userId} {
      allow read, create, update, delete: if false;
    }

    match /shipmentPricing/{pricingId} {
      allow read: if true;
      allow write: if request.auth != null &&
        hasAdminCapability(request.auth.uid, 'finance');
    }

    match /wallets/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin(request.auth.uid));
      allow write: if false;

      match /transactions/{transactionId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || isAdmin(request.auth.uid));
        allow write: if false;
      }
    }

    match /walletRefundRequests/{requestId} {
      allow read: if request.auth != null &&
        (resource.data.customerUid == request.auth.uid ||
         isAdmin(request.auth.uid) ||
         canManageBusiness(request.auth.uid, resource.data.businessId));
      allow write: if false;
    }

    match /barrelPoolBalanceRequests/{requestId} {
      allow read: if request.auth != null &&
        (resource.data.customerUid == request.auth.uid ||
         isAdmin(request.auth.uid) ||
         canManageBusiness(request.auth.uid, resource.data.businessId));
      allow write: if false;
    }

    match /carPurchases/{purchaseId} {
      // Purchases contain server-authoritative payment and fulfillment fields.
      // Every create must go through a guarded callable using the Admin SDK.
      allow create: if false;
      allow read: if request.auth != null &&
        resource.data.buyerUid == request.auth.uid;
      allow read: if request.auth != null &&
        (isAdmin(request.auth.uid) ||
         canManageBusiness(request.auth.uid, resource.data.businessId));
      // Admins keep full access (and money-moving actions run via Cloud Functions
      // with the Admin SDK, which bypasses these rules).
      allow update: if request.auth != null &&
        hasAdminCapability(request.auth.uid, 'operations');
      // A business may only nudge status/notes on a NON-finalized record, and may
      // never alter buyer, money, payment, hold, or extension fields, nor delete
      // the record. This stops deposit/payment tampering and history erasure;
      // forfeits/refunds/sales must go through the guarded callables.
      allow update: if request.auth != null &&
        canManageBusinessSection(request.auth.uid, resource.data.businessId, 'purchases') &&
        !(resource.data.purchaseStatus in ['completed', 'no_show', 'cancelled', 'refunded', 'forfeited']) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['purchaseStatus', 'staffNotes', 'updatedAt']) &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.buyerUid == resource.data.buyerUid &&
        request.resource.data.depositAmount == resource.data.depositAmount &&
        request.resource.data.paymentStatus == resource.data.paymentStatus;
      allow delete: if request.auth != null &&
        hasAdminCapability(request.auth.uid, 'operations');
    }
  }
} 
