# Laawol Digital — static site config

# Force HTTPS (Hostinger also offers this toggle in hPanel)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # The admin console moved to its own subdomain.
  RewriteRule ^admin(/.*)?$ https://admin.laawoldigital.com/ [L,R=301]

  # Short parking payment link. A walk-up customer receives this by SMS, and
  # the Cloud Function URL is 116 characters - long enough to push a parking
  # text into a second segment and far too long to read off a printed
  # invoice. /p?t=<token> is 61. QSA keeps the token; 302 rather than 301 so
  # the destination is never cached by a browser or an operator.
  #
  # PROJECT-SPECIFIC (the only two lines in this file that are). .htaccess cannot
  # read assets/site-config.js, so the active pair is kept here, with the
  # old project's pair beside it. Rollback: swap which pair is commented.
  # NEW_PROJECT_CONFIG (laawol-a855a), active since the 2026-10-20 cutover:
  RewriteRule ^p$ https://us-central1-laawol-a855a.cloudfunctions.net/parkingPaymentLink [QSA,R=302,L]
  RewriteRule ^d$ https://us-central1-laawol-a855a.cloudfunctions.net/parkingDocument [QSA,R=302,L]
  # Old project (car-selling-flutter-app) - rollback only; delete once it is decommissioned:
  # RewriteRule ^p$ https://us-central1-car-selling-flutter-app.cloudfunctions.net/parkingPaymentLink [QSA,R=302,L]
  # RewriteRule ^d$ https://us-central1-car-selling-flutter-app.cloudfunctions.net/parkingDocument [QSA,R=302,L]

  # A business's package request link (docs/PACKAGE_REQUESTS.md §8.8): the
  # printed QR and shared link read laawoldigital.com/r/<slug>; the form
  # lives on the customer host. 302 so a renamed slug is never cached.
  RewriteRule ^r/([A-Za-z0-9-]{3,40})/?$ https://customer.laawoldigital.com/r/$1 [R=302,L]
</IfModule>

# Default document
DirectoryIndex index.html

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

ErrorDocument 404 /index.html
