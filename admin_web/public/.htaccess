# Served by Apache on Hostinger for every console (admin, business,
# customer); next export copies this file into out/ unchanged.

# Apple fetches this file with no extension and requires JSON.
<Files "apple-app-site-association">
  ForceType application/json
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Tracking links printed on package labels and sent in WhatsApp updates:
  # /t/CL-K7M4P2. The app claims /t/ as a universal/app link; without the
  # app installed, the browser lands on the tracking page for that code.
  RewriteRule ^t/([A-Za-z0-9-]{4,40})/?$ /?service=tracking&code=$1 [R=302,L,QSA]
</IfModule>
