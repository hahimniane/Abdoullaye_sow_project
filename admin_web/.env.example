# Public score-based reCAPTCHA Enterprise site key registered for Firebase App Check.
# Required for production admin/business builds.
NEXT_PUBLIC_FIREBASE_APP_CHECK_RECAPTCHA_SITE_KEY=

# Local development only. Register this token in Firebase App Check first.
# Never define it in production builds.
NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN=

# Which Firebase project the console talks to. Unset = "current" (see
# src/lib/project-config.ts). Set to "new" at cutover after filling
# NEW_PROJECT_CONFIG there; the build throws if its apiKey/appId are empty.
# NEXT_PUBLIC_FIREBASE_PROJECT_TARGET=current
# Optional per-field overrides (win over either target):
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
